ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite:///./personal_finance.db
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
ALLOW_TEST_TOKENS=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=secret
SMTP_USE_TLS=true
EMAIL_SENDER=notificaciones@example.com
PASSWORD_RESET_URL=https://frontend.example.com/reset-password?token=
LOCAL_AUTH_SECRET=dev-local-secret-change-me
LOCAL_AUTH_TOKEN_EXPIRES_MINUTES=60
